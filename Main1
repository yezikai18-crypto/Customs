                print("Customs DEBUG: Arrow used. Waiting for stand...")
                local s = os.clock()
                repeat task.wait(0.5) until Util:HasStand() or (os.clock() - s > 10)
            else
                print("Customs DEBUG: Failed to use lucky arrow (or none left). Exiting stand farm.")
                break
            end

       elseif current ~= "nil" then
           
            -- Unconditionally log and send a webhook for EVERY skin rolled
            Util:LogSkinToFile(current)
            Util:SendWebhook(WebhookURL,
                "User: `"..tostring(Util:GetPlayer().Name).."`\nStand: `"..tostring(Util:CheckStand()).."`\nSkin: `"..tostring(current).."`\nPity: `"..tostring(Util:GetPlayer().PlayerStats.PityCount.Value).."`",
                "🖼️ NEW SKIN ROLLED!")
           
            if table.find(WantedShinys, current) then
                print("Customs DEBUG: !!! WANTED SKIN DETECTED: " .. tostring(current) .. " !!!")
               
                -- [BUGFIX: Added a brief safety delay so Discord doesn't drop the second back-to-back webhook due to rate limits]
                task.wait(1.5)

                Util:SendWebhook(WebhookURL,
                    "User: `"..tostring(Util:GetPlayer().Name).."`\nStand: `"..tostring(Util:CheckStand()).."`\nSkin: `"..tostring(current).."`\nPity: `"..tostring(Util:GetPlayer().PlayerStats.PityCount.Value).."`",
                    "🚨 WANTED SKIN OBTAINED!")
               
                local character = Util:GetCharacter()
                if character and character:FindFirstChild("SummonedStand") and character.SummonedStand.Value == true then
                    print("Customs DEBUG: Stand is summoned. Attempting to desummon for swap...")
                    local rf = character:FindFirstChild("RemoteFunction")
                    if rf then
                        rf:InvokeServer("ToggleStand", "Toggle")
                        task.wait(1.5)
                    end
                end
               
                print("Customs DEBUG: Scanning for empty slots to swap...")
                local foundEmptySlot = false
                local scrollingFrame = nil
               
                local pg = Util:GetPlayer():FindFirstChild("PlayerGui")
                local hud = pg and pg:FindFirstChild("HUD")
                local main = hud and hud:FindFirstChild("Main")
                local frames = main and main:FindFirstChild("Frames")
                local stands = frames and frames:FindFirstChild("Stands")
                scrollingFrame = stands and stands:FindFirstChild("ScrollingFrame")
               
                if scrollingFrame then
                    for i = 1, 6 do
                        local slotName = "Slot" + i -- Fixed string formatting or keep as "Slot" .. i
                        local slotObj = scrollingFrame:FindFirstChild("Slot" .. i)
                       
                        if slotObj then
                            local lbl = slotObj:FindFirstChild("TextLabel")
                            if lbl then
                                local txt = lbl.Text:lower()
                                if string.find(txt, "none") or string.find(txt, "empty") then
                                    print("Customs DEBUG: Found empty slot: Slot" .. i .. ". Swapping now!")
                                   
                                    local charAdded = false
                                    local conn = Util:GetPlayer().CharacterAdded:Connect(function() charAdded = true end)
                                   
                                    Util:GetCharacter().RemoteEvent:FireServer("SwapStand", "Slot" .. i)
                                   
                                    local s = os.clock()
                                    repeat task.wait(0.1) until charAdded or (os.clock() - s > 10)
                                    if conn then conn:Disconnect() end
                                   
                                    if charAdded then
                                        print("Customs DEBUG: Swap successful. Character respawned.")
                                        task.wait(3)
                                        TeleportTo(CFrame.new(978, -42, -49))
                                       
                                        print("Customs DEBUG: Resuming farm.")
                                        foundEmptySlot = true
                                        break
                                    else
                                        print("Customs DEBUG: Swap command sent but no respawn detected.")
                                    end
                                end
                            end
                        end
                    end
                   
                    if not foundEmptySlot then
                        print("Customs DEBUG: WARNING: No empty slots found! Cannot swap.")
                        break
                    end
                else
                    print("Customs DEBUG: Could not find HUD/ScrollingFrame to check slots.")
                end
               
            else
                print("Customs DEBUG: Unwanted skin ("..tostring(current).."). Using Roka.")
                Util:UseRoka()
            end
        end
       
        if not hasLucky and not hasRedeemed then
             print("Customs DEBUG: Out of usable lucky arrows. Exiting farm.")
             break
        end
        if Util:HasStand() and current ~= "None" and current ~= "nil" and not table.find(WantedShinys, current) and not hasRoka then
            print("Customs DEBUG: Unwanted stand and no Rokas left. Exiting farm.")
            break
        end
       
        task.wait(1.5)
    end
   
    print("Customs DEBUG: Stand farm loop finished. Proceeding to server hop.")
end
