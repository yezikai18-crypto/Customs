function Customs.Utils:CountItem(Item)
    local bp = self:GetPlayer().Backpack
    local cnt = 0
    for _, t in pairs(bp:GetChildren()) do if t.Name == Item then cnt = cnt + 1 end end
    local char = self:GetCharacter()
    local equippedTool = char:FindFirstChildWhichIsA("Tool")
    if equippedTool and equippedTool.Name == Item then
