local function ServerHop()
    -- Alert the user via Webhook right before beginning the active teleport phase
    local currentWallet = "Unknown"
    if Player:FindFirstChild("PlayerStats") and Player.PlayerStats:FindFirstChild("Money") then
        currentWallet = tostring(Player.PlayerStats.Money.Value)
    end
    print("Main Script: Preparing to hop server. Wallet balance: $" .. currentWallet)
    Customs.Utils:SendWebhook(
        getgenv().UserConfig.WebhookUrl,
        "User: `"..tostring(Player.Name).."` is server hopping.\nRemaining Cash: `$"..currentWallet.."`",
        "🌐 SERVER HOPPING..."
    )
    task.wait(1) -- Short buffer to guarantee webhook dispatch completes

    local url = "https://games.roblox.com/v1/games/" .. PlaceID .. "/servers/Public?sortOrder=Asc&limit=100"
    if foundCursor ~= "" then url = url .. "&cursor=" .. foundCursor end

    local httpSuccess, httpResult = pcall(function()
        return game:HttpGet(url)
    end)
   
    if not httpSuccess then
        warn("Server hop HTTPGet failed:", httpResult)
        return
    end
   
    local decodeSuccess, response = pcall(function()
        return HttpService:JSONDecode(httpResult)
    end)
   
    if not decodeSuccess then
        warn("Server hop JSONDecode failed:", response)
        return
    end

    foundCursor = response.nextPageCursor or ""

    if typeof(response.data) == "table" then
        local validServers = {}
        
        -- Collect all valid servers into a pool instead of picking the first one
        for _, server in pairs(response.data) do
            local id = tostring(server.id)
            local isNew = not table.find(AllIDs, id)
            local hasSpace = server.playing < server.maxPlayers

            if isNew and hasSpace then
                table.insert(validServers, id)
            end
        end

        if #validServers > 0 then
            -- Pick a random server from the valid pool
            local randomId = validServers[math.random(1, #validServers)]
            table.insert(AllIDs, randomId)
            writefile("NotSameServers.json", HttpService:JSONEncode(AllIDs))
           
            local teleportBound = false
            local connection
            connection = game.Players.LocalPlayer.OnTeleport:Connect(function(teleportState)
                if teleportState == Enum.TeleportState.Started then
                    teleportBound = true
                    connection:Disconnect()
                end
            end)
           
            TeleportService:TeleportToPlaceInstance(PlaceID, randomId, Players.LocalPlayer)
           
            task.wait(5)
           
            if not teleportBound then
                warn("TeleportService failed to initiate. Trying again...")
                connection:Disconnect()
                if table.find(AllIDs, randomId) then
                    table.remove(AllIDs, table.find(AllIDs, randomId))
                end
            end
           
            return
        end
    else
        warn("Server hop failed: response.data is not a table")
    end
   
    if foundCursor == "" then
        warn("Looped all servers, no new ones found. Resetting for next attempt.")
    end
end

local function Teleport()
    while true do
        local success, err = pcall(ServerHop)
        if not success then
            warn("ServerHop function crashed:", err)
        end
        task.wait(5)
    end
end

